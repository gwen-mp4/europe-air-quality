# Run `uv run dbt run --profiles-dir .` inside dbt/ folder
europe_air_quality:       # must match `profile:` in dbt_project.yml
  outputs:
    dev:
      type: duckdb
      path: dev.duckdb
      threads: 1
      extensions:
        - httpfs
        - parquet
      secrets:
        - type: s3
          region: "{{ env_var('S3_REGION') }}"
          key_id: "{{ env_var('S3_ACCESS_KEY_ID') }}"
          secret: "{{ env_var('S3_SECRET_ACCESS_KEY') }}"

  target: dev
